# ── Commission API ────────────────────────────────────────────────────────────
# Required in all environments. In dev/local the mock adapter is used and this
# key is NOT sent to any external service, but it must be set to prevent
# misconfigured deployments reaching production.
COMMISSION_API_KEY=your-api-key-here

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Keycloak admin credentials (used when running Keycloak via docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Issuer URI — Spring Boot fetches JWKS from this URL to validate Bearer tokens.
# Local dev (outside Docker): http://localhost:9090/realms/commission-app
# Docker Compose (inside Docker network): http://keycloak:8080/realms/commission-app
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/commission-app

# OAuth2 client used by Swagger UI for interactive login
KEYCLOAK_CLIENT_ID=commission-app-client
KEYCLOAK_REALM=commission-app

# Public URL for Keycloak — must be reachable from the user's browser.
# Used by the React frontend (baked in at build time by Vite).
# Local dev / Docker: http://localhost:9090
KEYCLOAK_PUBLIC_URL=http://localhost:9090
